---
layout: workspace.njk
title: Vendor information
screen: vendor
subtitle: Sample suppliers, contacts and payment terms
---
<section data-sample-list>
<div class="row g-3 align-items-end mb-3">
<div class="col-12 col-md-4">
<label class="form-label" for="sample-search">Find a vendor</label>
<input class="form-control" type="search" id="sample-search" data-sample-search>
</div>
<div class="col-12 col-md-4">
<label class="form-label" for="sample-category">Vendor status</label>
<select class="form-select" id="sample-category" data-sample-category>
<option value="all">All statuses</option>
<option>Active</option>
<option>Inactive</option>
</select>
</div>
</div>
<div class="card">
<div class="table-responsive" tabindex="0" role="region" aria-label="Sample vendor directory">
  <table class="table table-striped table-hover align-middle">
    <caption class="visually-hidden">Sample vendor directory</caption>
    <thead class="table-dark">
      <tr>
        <th scope="col">Vendor</th>
        <th scope="col">Category</th>
        <th scope="col">Status</th>
        <th scope="col" class="text-end">Open balance</th>
        <th scope="col">Contact details</th>
      </tr>
    </thead>
    <tbody>{% for item in samples.vendors %}<tr data-sample-item data-category="{{ item.status }}">
      <th scope="row" class="fw-normal">{{ item.name }}</th>
      <td>{{ item.type }}</td>
      <td>
        <span class="badge text-bg-secondary">{{ item.status }}</span>
      </td>
      <td class="text-end">{{ item.balance | money }}</td>
      <td>
        <details>
          <summary>View contact<span class="visually-hidden"> for {{ item.name }}</span>
          </summary>
          <dl class="mt-2 mb-0">
            <dt class="small">Contact</dt>
            <dd class="col-sm-6 border-bottom py-2 mb-0">{{ item.contact }}</dd>
            <dt class="small">Sample email</dt>
            <dd class="col-sm-6 border-bottom py-2 mb-0">{{ item.email }}</dd>
            <dt class="small">Payment terms</dt>
            <dd class="col-sm-6 border-bottom py-2 mb-0">{{ item.terms }}</dd>
          </dl>
        </details>
      </td>
      </tr>{% endfor %}
    </tbody>
  </table>
</div>
</div>
<p class="text-body-secondary p-4 text-center d-none" data-sample-empty hidden>No results match these filters. Try another search or category.</p>
<p class="small text-body-secondary" role="status" data-sample-count>
</p>
<p class="small text-body-secondary">Names and contact addresses are fictional. No messages or payments are sent.</p>
</section>
