---
layout: workspace.njk
title: Cost transactions
screen: costs
subtitle: N819 · Waldorf Astoria Hotel Millwork
---
<nav class="d-flex flex-wrap gap-3 mb-4" aria-label="Project cost views">
<a href="{{ '/project-info/N819/' | url }}">Project information</a>
<a href="{{ '/costs/cost-summary/' | url }}">Cost summary</a>
<a href="{{ '/costs/to-date-costs/' | url }}">Cost transactions</a>
<a href="{{ '/project-costs/breakout/' | url }}">Category breakout</a>
<a href="{{ '/plans/' | url }}">Plans</a>
</nav>
<section class="card bg-body mb-4">
<div class="card-body d-flex flex-wrap justify-content-between gap-3">
<div>
<h2 class="h5">October transaction sample</h2>
<p class="text-body-secondary mb-0">Oct 9–16, 2026 · Five illustrative ledger entries</p>
</div>
<p class="mb-0 small text-body-secondary">A sample subset, not the complete project ledger.</p>
</div>
</section>
<section data-sample-list>
<div class="row g-3 align-items-end mb-3">
<div class="col-12 col-md-2">
<label class="form-label" for="sample-search">Search transactions</label>
<input class="form-control" type="search" id="sample-search" data-sample-search>
</div>
<div class="col-12 col-md-2">
<label class="form-label" for="sample-category">Cost category</label>
<select class="form-select" id="sample-category" data-sample-category>
<option value="all">All categories</option>{% for item in samples.categories %}<option>{{ item.name }}</option>{% endfor %}</select>
</div>
</div>
<div class="card">
<div class="table-responsive" tabindex="0" role="region" aria-label="October sample cost transactions">
<table class="table table-striped table-hover align-middle">
<caption class="visually-hidden">October sample cost transactions</caption>
<thead class="table-dark">
<tr>
<th scope="col">Date</th>
<th scope="col">Reference</th>
<th scope="col">Description</th>
<th scope="col">Category</th>
<th scope="col" class="text-end">Amount</th>
</tr>
</thead>
<tbody>{% for item in samples.transactions %}<tr data-sample-item data-category="{{ item.category }}">
<td class="text-nowrap">{{ item.date }}</td>
<th scope="row" class="fw-normal">{{ item.reference }}</th>
<td>{{ item.description }}</td>
<td>{{ item.category }}</td>
<td class="text-end">{{ item.amount | money }}</td>
</tr>{% endfor %}</tbody>
</table>
</div>
</div>
<p class="text-body-secondary p-4 text-center d-none" data-sample-empty hidden>No results match these filters. Try another search or category.</p>
<p class="small text-body-secondary" role="status" data-sample-count>
</p>
</section>
