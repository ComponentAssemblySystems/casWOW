---
layout: workspace.njk
title: Employees
screen: employees
subtitle: Sample team directory and project assignments
---
<section data-sample-list>
<div class="row g-3 align-items-end mb-3">
<div class="col-12 col-md-4">
<label class="form-label" for="sample-search">Find an employee</label>
<input class="form-control" type="search" id="sample-search" data-sample-search>
</div>
<div class="col-12 col-md-4">
<label class="form-label" for="sample-category">Employee status</label>
<select class="form-select" id="sample-category" data-sample-category>
<option value="all">All statuses</option>
<option>Active</option>
<option>Inactive</option>
</select>
</div>
</div>
<div class="card">
<div class="table-responsive" tabindex="0" role="region" aria-label="Sample employee assignments">
<table class="table table-striped table-hover align-middle">
<caption class="visually-hidden">Sample employee assignments</caption>
<thead class="table-dark">
<tr>
<th scope="col">Employee</th>
<th scope="col">Role</th>
<th scope="col">Assigned project</th>
<th scope="col">Status</th>
<th scope="col">Assignment date</th>
</tr>
</thead>
<tbody>{% for item in samples.employees %}<tr data-sample-item data-category="{{ item.status }}">
<th scope="row" class="fw-normal">{{ item.name }}<span class="d-block small text-body-secondary">{{ item.id }}</span>
</th>
<td>{{ item.role }}</td>
<td>
<a href="{{ ('/project-info/' + item.project + '/') | url }}">Project {{ item.project }}</a>
</td>
<td>{{ item.status }}</td>
<td>{{ item.date }}</td>
</tr>{% endfor %}</tbody>
</table>
</div>
</div>
<p class="text-body-secondary p-4 text-center d-none" data-sample-empty hidden>No results match these filters. Try another search or category.</p>
<p class="small text-body-secondary" role="status" data-sample-count>
</p>
<p class="small text-body-secondary">Fictional directory for layout review. No personnel records are connected.</p>
</section>
