<section class="card bg-body mb-3" aria-labelledby="financial-title">
  <div class="card-body p-4">
    <h2 class="h4 mb-3" id="financial-title">Financial summary</h2>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-4">
      {% for label, key in [['Adjusted contract amount', 'adjusted'], ['Costs to date', 'costs'], ['Billed to date', 'billed'], ['Payments received', 'paid']] %}
      <div class="col d-flex gap-4">
        {% if not loop.first %}<div class="vr d-none d-xl-block" aria-hidden="true"></div>{% endif %}
        <dl class="mb-0" data-metric>
          <dt class="text-body-secondary fw-normal mb-1">{{ label }}</dt>
          <dd class="h2 mb-0">{{ project.financial[key] | money }}</dd>
          {% if key == 'costs' %}<dd class="text-body-secondary mt-1 mb-0">64.4% of adjusted contract</dd>{% endif %}
        </dl>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
<div class="row g-3">
  <div class="col-12 col-lg-7">
    <section class="card bg-body h-100" aria-labelledby="project-details-title">
      <div class="card-body p-4">
        <h2 class="h4 mb-3" id="project-details-title">Project details</h2>
        <dl class="mb-0">
          {% for label, value in [['Project number', project.id], ['Project manager', project.manager], ['Project date', project.date], ['Original contract amount', project.financial.original | money]] %}
          <div class="row g-0 py-2{% if not loop.last %} border-bottom{% endif %}"><dt class="col-sm-5 fw-normal text-body-secondary">{{ label }}</dt><dd class="col-sm-7 mb-0">{{ value }}</dd></div>
          {% endfor %}
        </dl>
        <hr class="my-4">
        <h2 class="h4 mb-3">Contractor and contact</h2>
        <dl class="mb-0">
          {% for label, value in [['General contractor', project.contractor], ['Contact', project.contact], ['Phone', project.phone], ['Address', project.address]] %}
          <div class="row g-0 py-2{% if not loop.last %} border-bottom{% endif %}"><dt class="col-sm-5 fw-normal text-body-secondary">{{ label }}</dt><dd class="col-sm-7 mb-0">{% if label == 'Phone' %}<a class="text-body" href="tel:+16468795682">{{ value }}</a>{% else %}{{ value }}{% endif %}</dd></div>
          {% endfor %}
        </dl>
      </div>
    </section>
  </div>
  <div class="col-12 col-lg-5">
    <section class="card bg-body h-100" aria-labelledby="billing-title">
      <div class="card-body p-4">
        <h2 class="h4 mb-3" id="billing-title">Cost and billing details</h2>
        <dl class="mb-0">
          {% for label, key in [['Subcontract costs not in books', 'subcontract'], ['Open purchase orders', 'purchaseOrders'], ['Total project costs', 'costs'], ['Pending change orders', 'pending'], ['Extra work orders', 'extra'], ['Proposals', 'proposals'], ['Overhead G&A', 'overhead']] %}
          <div class="row g-0 py-2{% if key == 'costs' %} border-bottom pb-4 mb-3{% else %} border-bottom{% endif %}">
            <dt class="col-8 fw-normal text-body-secondary">{{ label }}</dt><dd class="col-4 text-end mb-0">{{ project.financial[key] | money }}</dd>
          </div>
          {% endfor %}
          <div class="row g-0 py-2"><dt class="col-6 fw-normal text-body-secondary">Last entry</dt><dd class="col-6 text-end mb-0">{{ project.lastEntry }}</dd></div>
        </dl>
        <p class="small text-body-secondary mt-4 mb-0">Illustrative data. COR images are not included in this sample.</p>
      </div>
    </section>
  </div>
</div>
