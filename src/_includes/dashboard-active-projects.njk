<section class="card bg-body border-0 shadow-sm h-100" aria-labelledby="active-projects-sidebar-title">
  <header class="card-header bg-transparent border-0 px-4 pt-4 pb-0">
    <div class="d-flex align-items-center justify-content-between">
      <h2 class="h5 mb-1 fw-bold" id="active-projects-sidebar-title">Active Projects</h2>
      <div class="d-flex gap-1">
        <button type="button" class="btn btn-sm btn-outline-secondary p-1" aria-label="Share">
          <i class="fa fa-share fa-xs" aria-hidden="true"></i>
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary p-1" aria-label="More">
          <i class="fa fa-ellipsis-vertical fa-xs" aria-hidden="true"></i>
        </button>
      </div>
    </div>
    <p class="small text-body-secondary mb-0">across CAS-NY</p>
  </header>
  <div class="card-body px-4 pb-0 pt-3">
    <div class="list-group list-group-flush">
      {% for job in dashboardData.activeProjects %}
      <div class="list-group-item border-0 px-0 py-2">
        <div class="d-flex align-items-center gap-2 mb-2">
          <div class="d-flex align-items-center justify-content-center" style="width: 18px;">
            <i class="fa fa-building fa-sm" aria-hidden="true"></i>
          </div>
          <h3 class="small mb-0 fw-medium text-truncate" title="{{ job.name }}">{{ job.name }}</h3>
          <span class="badge rounded-pill bg-dark small ms-auto">{{ job.badge }}</span>
        </div>
        {% if job.progressLabel %}
        <div>
          <div class="d-flex justify-content-between small text-body-secondary mb-1">
            <span>{{ job.progressLabel }}</span>
            <span>{{ job.progressPercent }}%</span>
          </div>
          <div class="progress" style="height: 12px; border-radius: 8px;">
            <div class="progress-bar bg-primary" role="progressbar" style="width: {{ job.progressPercent }}%" aria-valuenow="{{ job.progressPercent }}" aria-valuemin="0" aria-valuemax="100"></div>
          </div>
        </div>
        {% else %}
        <div class="progress" style="height: 12px; border-radius: 8px;">
          <div class="progress-bar bg-dark" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  <footer class="card-footer bg-transparent border-0 px-4 pt-3 pb-4">
    <div class="d-flex gap-2">
      <button type="button" class="btn btn-outline-secondary btn-sm flex-grow-1">
        <i class="fa fa-map me-1" aria-hidden="true"></i>
        Show on map
      </button>
      <button type="button" class="btn btn-outline-secondary btn-sm flex-grow-1">
        Project Costs
      </button>
    </div>
  </footer>
</section>
